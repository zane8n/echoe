{
  "name": "Echoe: build a rhythm you can trust",
  "short_name": "Echoe",
  "id": "/",
  "description": "A calm milestone and habit tracker for practical growth.",
  "start_url": "/?source=homescreen",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "lang": "en",
  "categories": ["productivity", "lifestyle"],
  "background_color": "#fffdf8",
  "theme_color": "#fffdf8",
  "icons": [
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Add a path",
      "short_name": "Add path",
      "url": "/?action=add",
      "icons": [{ "src": "/apple-touch-icon.png", "sizes": "180x180", "type": "image/png" }]
    },
    {
      "name": "Open paths",
      "short_name": "Paths",
      "url": "/#paths",
      "icons": [{ "src": "/apple-touch-icon.png", "sizes": "180x180", "type": "image/png" }]
    }
  ]
}
